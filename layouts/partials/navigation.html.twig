{%- if menu|length > 1 ~%}
<nav class="navbar navbar-expand-md">
    <div class="container">
        {# Left: always visible controls #}
        <div class="navbar-nav flex-row align-items-center">
            <div class="nav-item px-2">
                <a href="#" data-theme-toggle title="{{ 'change_theme'|trans }}" aria-label="{{ 'change_theme'|trans }}">
                    <i class="fas fa-moon" aria-hidden="true"></i>
                </a>
            </div>
            <div class="nav-item px-2">
                {%- set targetLang = site.language == 'fr' ? 'en' : 'fr' -%}
                {%- set translation = page.translations|filter(t => t.language == targetLang)|first -%}
                {%- if translation -%}
                    {%- set targetUrl = url(translation) -%}
                {%- else -%}
                    {%- set targetUrl = targetLang == 'fr' ? url('fr/' ~ page.id) : url(page.id) -%}
                {%- endif -%}
                <a href="{{ targetUrl }}" title="{{ targetLang == 'fr' ? 'switch_to_french'|trans : 'switch_to_english'|trans }}">
                    {{- targetLang == 'fr' ? '🇫🇷' : '🇬🇧' -}}
                </a>
            </div>
            <div class="nav-item px-2 dropdown">
                <a href="#" class="dropdown-toggle" data-bs-toggle="dropdown" title="{{ 'feeds'|trans }}" aria-label="{{ 'feeds'|trans }}">
                    <i class="fas fa-rss"></i>
                </a>
                <ul class="dropdown-menu dropdown-menu-end">
                    <li><a class="dropdown-item" href="{{ url('feed.xml') }}">{{ 'rss_feed'|trans }}</a></li>
                    <li><a class="dropdown-item" href="{{ url('atom.xml') }}">{{ 'atom_feed'|trans }}</a></li>
                    <li><a class="dropdown-item" href="{{ url('feed.json') }}">{{ 'json_feed'|trans }}</a></li>
                    <li><a class="dropdown-item" href="{{ url('feed.md') }}">{{ 'llm_feed'|trans }}</a></li>
                </ul>
            </div>
        </div>
        {# Toggler: visible on < md #}
        <button class="navbar-toggler ms-auto" type="button" data-bs-toggle="collapse" data-bs-target="#mainNav" aria-controls="mainNav" aria-expanded="false" aria-label="Toggle navigation">
            <span class="navbar-toggler-icon"></span>
        </button>
        {%- set menu_keys = {index: 'home', blog: 'blog', 'about-me': 'about_me', legal: 'legal', tags: 'tags_label'} ~%}
        <div class="collapse navbar-collapse flex-grow-0" id="mainNav">
            <div class="navbar-nav ms-auto align-items-md-center">
                {%- for item in site.menus[menu]|sort_by_weight ~%}
                    <div class="nav-item px-2">
                        {%- set is_current = page.id == item.id or page.section == item.id -%}
                        <a class="nav-link{% if is_current %} active{% endif %}" href="{{ url(item.id, {language: site.language}) }}"{% if is_current %} aria-current="page"{% endif %}>{{ attribute(menu_keys, item.id)|default('menu_' ~ item.id)|trans }}</a>
                    </div>
                {%- endfor ~%}
            </div>
        </div>
    </div>
</nav>
{%- endif ~%}
