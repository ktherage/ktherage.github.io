{#- Structured data ~#}
    <script type="application/ld+json">{%- apply minify_js ~%}
       [
{#- Person ~#}
        {
          "@context": "https://schema.org",
          "@type": "Person",
          "@id": "{{ url(site, {canonical: true}) }}#person",
          "name": "{{ site.author.name|e('js') }}",
          "url": "{{ site.author.url|default(url(site, {canonical: true})) }}",
          "image": "{{ url(asset(site.author.image), {canonical: true}) }}",
          "jobTitle": "{{ 'author_title'|trans|e('js') }}",
          "description": "{{ site.author.bio|default(site.description)|e('js') }}",
          "sameAs": [
            {%- for social in site.social|default([]) %}
            "{{ social.url|e('js') }}"{% if not loop.last %},{% endif %}
            {%- endfor %}
          ]
        },
{#- WebSite ~#}
        {%- cache cache_key('jsonld-website') ~%}
        {
          "@context": "https://schema.org",
          "@type": "WebSite",
          "name": "{{ 'site_name'|trans|e('js') }}",
          "description": "{{ site.description|e('js') }}",
          "url": "{{ url(site.home, {canonical: true}) }}"
          {%- if site.image|default ~%},
          "image": [
            "{{ url(asset(site.image), {canonical: true}) }}"
          ]
          {%- endif ~%}
          {%- set socials = page.social|default(site.social|default([]))|filter((v) => v['url'] is defined) -%}
          {%- if socials|length > 0 ~%},
          "sameAs": [
            {%- for social in socials ~%}
            "{{ social.url }}"{% if not loop.last %},{% endif %}
            {%- endfor ~%}
          ]
          {%- endif ~%}
        }
        {%- endcache ~%}
{#- SiteNavigationElement ~#}
        {%- set items = site.menus.main|default([])|filter(i => i.id != site.home)|sort_by_weight -%}
        {%- if items|length > 0 -%}
        {%- cache cache_key('jsonld-navigation', site.menus.main) -%}
        ,{
          "@context": "https://schema.org",
          "@type": "ItemList",
          "itemListElement": [
            {%- for item in site.menus.main|filter(i => i.id != site.home)|sort_by_weight ~%}
            {
              "@type": "SiteNavigationElement",
              "position": {{ loop.index }},
              "name": "{{ site.page(item.id).title|default(item.name)|e('js') }}",
              "description": "{{ site.page(item.id).description|default|e('js') }}",
              "url": "{{ url(item.url, {canonical: true}) }}"
            }{%- if not loop.last %},{% endif -%}
            {%~ endfor ~%}
          ]
        }
        {%- endcache ~%}
        {%- endif -%}
{#- WebPage ~#}
        {%- if page.id != '404' -%}
        ,{
          "@context": "https://schema.org",
          "@type": "WebPage",
          "name": "{{ title|default(page.title)|e('js') }}",
          "description": "{{ page.description|default(site.description)|e('js') }}",
          "publisher": {
            "@type": "Organization",
            "name": "{{ 'site_name'|trans|e('js') }}",
            {%- set icon_asset = asset('icon.png', {ignore_missing: true}) ~%}
            {%- if not icon_asset.missing ~%}
            "logo": "{{ url(icon_asset, {canonical: true}) }}",
            {%- endif ~%}
            "url": "{{ url(site.home, {canonical: true}) }}"
          }
        }
        {%- endif ~%}
        {%- if page.section -%}
{#- BreadcrumbList -#}
        ,{
          "@context": "https://schema.org",
          "@type": "BreadcrumbList",
          "itemListElement": [
            {
              "@type": "ListItem",
              "position": 1,
              "name": "{{ 'home'|trans|e('js') }}",
              "item": "{{ url(site.home, {canonical: true}) }}"
            }{%- for section in page.ancestors|default([])|reverse ~%}
            ,{
              "@type": "ListItem",
              "position": {{ loop.index + 1 }},
              "name": "{{ section.title|default(section)|e('js') }}",
              "item": "{{ url(section, {canonical: true}) }}"
            }{%- endfor ~%}
            ,{
              "@type": "ListItem",
              "position": {{ page.ancestors|default([])|length + 2 }},
              "name": "{{ title|default(page.title)|e('js') }}",
              "item": "{{ url(page, {canonical: true}) }}"
            }
          ]
        }
{#- NewsArticle ~#}
          {%- if page.section == config.metatags.articles|default('blog') and page.type != 'section' -%}
        ,{
          "@context": "https://schema.org",
          "@type": "NewsArticle",
          "mainEntityOfPage": {
            "@type": "WebPage",
            "@id": "{{ url(page, {canonical: true}) }}"
          },
          "headline": "{{ title|default(page.title)|e('js') }}",
          {%- if page.image|default ~%}
          "image": [
            "{{ url(asset(page.image), {canonical: true}) }}"
          ],
          {%- endif ~%}
          "datePublished": "{{ page.date|date('Y-m-dTH:i:sP') }}",
          {%- if page.updated|default ~%}
          "dateModified": "{{ page.updated|date('Y-m-dTH:i:sP') }}",
          {%- endif ~%}
          {%- if author.name|default ~%}
          "author": {
            "@type": "Person",
            "name": "{{ author.name|e('js') }}"
            {%- if author.url|default ~%},
            "url": "{{ author.url }}"
            {%- endif ~%}
            {%- if author.image|default ~%},
            "image": "{{ author.image }}"
            {%- endif ~%}
            {%- if author.title|default ~%},
            "jobTitle": "{{ author.title|default('author_title'|trans)|e('js') }}"
            {%- endif ~%}
            {%- if author.email|default ~%},
            "email": "{{ author.email }}"
            {%- endif ~%}
            {%- if author.telephone|default ~%},
            "telephone": "{{ author.telephone }}"
            {%- endif ~%}
          },
          {%- endif ~%}
          "publisher": {
            "@type": "Organization",
            "name": "{{ 'site_name'|trans|e('js') }}",
            {%- set icon_asset = asset('icon.png', {ignore_missing: true}) ~%}
            {%- if not icon_asset.missing ~%}
            "logo": "{{ url(icon_asset, {canonical: true}) }}",
            {%- endif ~%}
            "url": "{{ url(site.home, {canonical: true}) }}"
          }
        }
          {%- endif ~%}
        {%- endif ~%}
{#- VideoObject ~#}
        {%- if page.videos[0]|default -%}
        ,{
          "@context": "https://schema.org",
          "@type": "VideoObject",
          "name": "{{ title|default(page.title)|e('js') }}",
          {%- if page.description|default ~%}
          "description": "{{ page.description|e('js') }}",
          {%- endif ~%}
          {%- if page.image|default ~%}
          "thumbnailUrl": [
            "{{ url(asset(page.image)|resize(640), {canonical: true}) }}"
          ],
          {%- endif ~%}
          "uploadDate": "{{ page.date|date('Y-m-dTH:i:sP') }}",
          "duration": "{{ asset(page.videos[0]).video.duration|duration_to_iso8601 }}",
          "contentUrl": "{{ url(asset(page.videos[0]), {canonical: true}) }}",
          "embedUrl": "{{ url(page, {canonical: true, format: 'embed'}) }}"
        }
        {%- endif -%}
{#- Blog (homepage) ~#}
        {%- if page.type == 'homepage' -%}
        {%- set latest_posts = site.pages|filter(p => p.section == 'blog' and p.title is defined and p.date is defined and p.date <= date() and p.id != page.id and p.virtual == false)|sort_by_date|slice(0, 3) -%}
        {%- if latest_posts|length > 0 -%}
        ,{
          "@context": "https://schema.org",
          "@type": "Blog",
          "@id": "{{ url('blog/', {canonical: true}) }}#blog",
          "name": "Blog de {{ site.author.name }}",
          "description": "{{ site.description|e('js') }}",
          "blogPost": [
            {%- for post in latest_posts %}
            {
              "@type": "BlogPosting",
              "headline": "{{ post.title|e('js') }}",
              "url": "{{ url(post, {canonical: true}) }}",
              "datePublished": "{{ post.date|date('c') }}",
              "dateModified": "{{ post.updated|default(post.date)|date('c') }}",
              "description": "{{ post.description|default(post.excerpt|striptags)|e('js') }}",
              "mainEntityOfPage": {
                "@type": "WebPage",
                "@id": "{{ url(post, {canonical: true}) }}"
              }{% if post.cover.image is defined and post.cover.image is not null %},
              "image": {
                "@type": "ImageObject",
                "url": "{{ url(asset(post.cover.image), {canonical: true}) }}",
                "width": "1200",
                "height": "630"
              }{% elseif post.image is defined and post.image is not null %},
              "image": {
                "@type": "ImageObject",
                "url": "{{ url(asset(post.image), {canonical: true}) }}",
                "width": "1200",
                "height": "630"
              }{% endif %}
            }{% if not loop.last %},{% endif %}
            {%- endfor %}
          ]
        }
        {%- endif -%}
        {%- endif -%}
      ]
    {% endapply %}</script>
