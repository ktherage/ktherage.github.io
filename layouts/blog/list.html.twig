{% extends '_default/list.html.twig' %}

{% block content %}
    <div class="d-flex flex-column flex-grow-1">
        <div class="container my-5">
            <header class="mb-5 text-center">
                <h1 class="display-5 fw-bold">{{ page.title }}</h1>
                {# Only the blog landing page (page.path `blog`, language-neutral) gets the intro and the feeds #}
                {% if page.path == 'blog' %}
                    <p class="lead text-muted">{{ 'blog_lead'|trans }}</p>
                    <nav class="d-flex justify-content-center gap-2 mt-4" aria-label="{{ 'blog_subscribe'|trans }}">
                        <a href="{{ url(page, {canonical: true, format: 'atom'}) }}" class="btn btn-sm btn-outline-secondary" type="application/atom+xml">
                            <i class="fa-solid fa-rss me-1" aria-hidden="true"></i>Atom
                        </a>
                        <a href="{{ url(page, {canonical: true, format: 'rss'}) }}" class="btn btn-sm btn-outline-secondary" type="application/rss+xml">
                            <i class="fa-solid fa-rss me-1" aria-hidden="true"></i>RSS
                        </a>
                        <a href="{{ url(page, {canonical: true, format: 'json'}) }}" class="btn btn-sm btn-outline-secondary" type="application/json">
                            <i class="fa-solid fa-code me-1" aria-hidden="true"></i>JSON
                        </a>
                    </nav>
                {% endif %}
            </header>

            {# Tag cloud — sourced from Cecil's vocabulary, so the badge list is always in sync with the taxonomy #}
            {% set tags_vocab = site.taxonomies.get('tags') %}
            {% if tags_vocab and tags_vocab|length > 0 %}
                <div class="mb-4 text-center" role="group" aria-label="{{ 'filter_by_tag'|trans }}">
                    <button type="button" class="badge bg-primary me-2 mb-2 filter-badge active border-0" data-filter="all"
                            aria-pressed="true">{{ 'all_label'|trans }}</button>
                    {% for term in tags_vocab|sort_by_title %}
                        <button type="button" class="badge bg-secondary me-2 mb-2 filter-badge border-0" data-filter="{{ term.name|slugify }}"
                                aria-pressed="false">{{ term.name }}</button>
                    {% endfor %}
                </div>
            {% endif %}

            <div class="row g-4" role="list" id="blog-posts" aria-live="polite">
                {{ include('partials/post-card.html.twig', {pages: pages}) }}
            </div>
        </div>
    </div>
{% endblock content %}

{% block javascripts %}
    {{ parent() }}
    <script src="{{ asset('js/blog/tag-filter.js') }}"></script>
{% endblock javascripts %}
