{% extends '_default/page.html.twig' %}

{% block head %}
    {{ parent() }}
    <link rel="stylesheet" href="{{ asset('css/blog/heading-anchors.css') }}">
    <link rel="stylesheet" href="{{ asset('css/blog/table-of-content.css') }}">
    <link rel="stylesheet" href="{{ asset('css/blog/repo-callout.css') }}">
{% endblock %}

{%- block content ~%}
    <div class="container">
        {# Floating table of contents #}
        <aside id="toc" class="toc-floating" aria-label="{{ 'toc_title'|trans|default('On this page') }}">
            <p class="toc-title">{{ 'toc_title'|trans|default('On this page') }}</p>
            <ul id="toc-list" class="toc-list"></ul>
        </aside>
        <button id="toc-toggle" class="toc-toggle" type="button" aria-label="{{ 'toc_toggle'|trans|default('Toggle table of contents') }}" aria-expanded="false">
            <i class="fas fa-list" aria-hidden="true"></i>
        </button>
        <div class="row justify-content-center">
            <div class="col-lg-12 col-xl-10">
                <article class="blog-post">
                    {{- include('partials/breadcrumb.html.twig', {page: page}, with_context: false) ~}}
                    <header class="mb-4 pb-4 border-bottom">
                        {% if page.tags is defined %}
                            <div class="mb-3">
                                {% for tag in page.tags %}
                                    <a href="{{ url('tags/' ~ tag|slugify) }}" class="badge bg-secondary text-decoration-none me-1 mb-1">{{ tag }}</a>
                                {% endfor %}
                            </div>
                        {% endif %}
                        {# Image de cover #}
                        {% if page.cover is defined and page.cover.image %}
                            {%- set cover_img = asset(page.cover.image) -%}
                            <div class="d-flex flex-wrap align-items-center justify-content-center mb-4">
                                <img src="{{ url(cover_img|resize(1200, 630, 'cover')) }}"
                                    srcset="{{ url(cover_img|resize(800, 450, 'cover')) }} 800w,
                                            {{ url(cover_img|resize(1200, 630, 'cover')) }} 1200w"
                                    sizes="(max-width: 768px) 100vw, 1200px"
                                    width="1200"
                                    height="630"
                                    alt="{{ page.cover.alt|default('cover_image_for'|trans({'%title%': page.title})) }}"
                                    class="img-fluid rounded shadow-sm w-100 cover-image"
                                    decoding="async">
                                {% if page.cover.caption is defined and page.cover.caption is not null %}
                                    <p class="text-muted text-center mb-0">{{ page.cover.caption|raw }}</p>
                                {% endif %}
                            </div>
                        {% endif %}
                        <h1 class="display-5 fw-bold mb-3">{{ page.title|e }}</h1>
                        <div class="d-flex flex-wrap align-items-center gap-3 text-muted mb-3">
                            <time class="small">
                                <i class="bi bi-calendar3 me-1"></i>
                                {{ page.date|format_date('long') }}
                            </time>
                        </div>
                    </header>

                    {% if page.repository is defined and page.repository is not empty %}
                        <div class="repo-callout" role="note" aria-label="{{ 'repo_callout_text'|trans }}">
                            <span class="repo-callout-icon" aria-hidden="true">
                                {# Octocat – GitHub mark, fill currentColor #}
                                <svg height="32" width="32" viewBox="0 0 16 16" version="1.1" aria-hidden="true"><path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.06-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.013 8.013 0 0016 8c0-4.42-3.58-8-8-8z"></path></svg>
                            </span>
                            <span class="repo-callout-text">{{ 'repo_callout_text'|trans }} <a href="{{ page.repository }}" target="_blank" rel="noopener noreferrer">{{ page.repository|replace({'https://': '', 'http://': ''}) }}</a></span>
                        </div>
                    {% endif %}

                    <div class="blog-content">
                        {{ page.content }}
                    </div>

                    <footer class="mt-5 pt-4 border-top">
                        {{- include('partials/page-navigation.html.twig', {page: page}, with_context: false) ~}}
                    </footer>
                </article>

                {% if page.comments is not defined or page.comments %}
                    <hr class="my-5">
                    <section id="comments" class="mt-4">
                        <h2 class="h4 mb-4">{{ 'comments'|trans }}</h2>
                        <div id="giscus-comments"></div>
                    </section>
                {% endif %}
            </div>
        </div>
    </div>
{%- endblock content ~%}

{%- block javascripts ~%}
    {{ parent() }}
    <script src="{{ asset('vendor/mermaid-11.17.2/mermaid.min.js') }}"></script>
    <script src="{{ asset('js/blog/mermaid.js') }}"></script>
    <script src="{{ asset('vendor/highlightjs-11.12.0/highlight.min.js') }}"></script>
    <script src="{{ asset('js/blog/highlight.js') }}"></script>
    <script src="{{ asset('js/blog/heading-anchors.js') }}"></script>
    <script src="{{ asset('js/blog/table-of-content.js') }}"></script>
    <script src="{{ asset('js/blog/giscus.js') }}"></script>
    <script src="{{ asset('js/blog/anchor-url.js') }}"></script>
{%- endblock javascripts ~%}
